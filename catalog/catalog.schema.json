{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LXTool catalog v1",
  "type": "object",
  "required": ["schemaVersion", "tools"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "exampleOnly": {"type": "boolean"},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "repository", "category", "delivery"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "description": {"type": "string", "maxLength": 2000},
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "category": {"enum": ["3ds Max", "Unity", "通用工具"]},
          "delivery": {"const": "github-release-zip"},
          "assetPattern": {"type": "string", "minLength": 1},
          "includePrereleases": {"type": "boolean", "default": false},
          "integration": {"enum": ["manual", "unity-package", "maxscript", "standalone"], "default": "manual"}
        }
      }
    }
  }
}
